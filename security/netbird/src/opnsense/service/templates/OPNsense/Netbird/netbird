{% if helpers.exists('OPNsense.netbird.settings.general.enable') and OPNsense.netbird.settings.general.enable == '1' %}
netbird_enable="YES"
netbird_setup="/usr/local/sbin/pluginctl -c netbird_sync_config"
netbird_logfile="syslog"
netbird_loglevel="{{ helpers.getNodeByTag('OPNsense.netbird.settings.syslog.logLevel')|default('info', true) }}"
netbird_tun_dev="{{ OPNsense.netbird.settings.general.interface|default('wt0', true) }}"
{%   if OPNsense.netbird.settings.general.forceRelay|default('0') == '1' %}
netbird_env="NB_FORCE_RELAY=true"
{%   endif %}
{% else %}
netbird_enable="NO"
{% endif %}
