<model>
    <mount>//OPNsense/netbird/settings</mount>
    <description>NetBird settings</description>
    <version>1.3.0</version>
    <items>
        <general>
            <enable type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enable>
            <wireguardPort type="IntegerField">
                <Default>51820</Default>
                <Required>Y</Required>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>65535</MaximumValue>
                <ValidationMessage>Please specify a valid port.</ValidationMessage>
            </wireguardPort>
            <mtu type="IntegerField">
                <Default>1280</Default>
                <Required>Y</Required>
                <MinimumValue>576</MinimumValue>
                <MaximumValue>8192</MaximumValue>
                <ValidationMessage>Please specify a valid MTU (576-8192).</ValidationMessage>
            </mtu>
            <ipmapping type="CSVListField">
                <MaskPerItem>Y</MaskPerItem>
                <Mask>/^(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(?:\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}(?:\/(?:(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(?:\.(?:25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}|[a-zA-Z][a-zA-Z0-9_.-]*))?$/u</Mask>
                <ValidationMessage>Please specify an external IP, optionally followed by /local IP or /interface.</ValidationMessage>
            </ipmapping>
            <ifaceBlacklist type="InterfaceField">
                <Multiple>Y</Multiple>
            </ifaceBlacklist>
            <networkMonitor type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </networkMonitor>
            <disableAutoConnect type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </disableAutoConnect>
            <forceRelay type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </forceRelay>
        </general>
        <ssh>
            <enable type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enable>
            <enableRoot type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enableRoot>
            <enableSFTP type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enableSFTP>
            <enableLocalPortForwarding type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enableLocalPortForwarding>
            <enableRemotePortForwarding type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enableRemotePortForwarding>
        </ssh>
        <dns>
            <enable type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enable>
        </dns>
        <routing>
            <trafficHandling type="OptionField">
                <Default>netbird</Default>
                <Required>Y</Required>
                <OptionValues>
                    <netbird>NetBird mode (userspace filter and forwarder)</netbird>
                    <opnsense>OPNsense mode (pf and kernel routing)</opnsense>
                </OptionValues>
            </trafficHandling>
            <acceptServerRoutes type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </acceptServerRoutes>
            <accessLan type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </accessLan>
            <blockInbound type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </blockInbound>
            <acceptClientRoutes type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </acceptClientRoutes>
        </routing>
        <postquantum>
            <enableRosenpass type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enableRosenpass>
            <rosenpassPermissive type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </rosenpassPermissive>
        </postquantum>
        <syslog>
            <logLevel type="OptionField">
                <Required>Y</Required>
                <Default>info</Default>
                <OptionValues>
                    <fatal>fatal</fatal>
                    <error>error</error>
                    <warn>warn</warn>
                    <info>info</info>
                    <debug>debug</debug>
                    <trace>trace</trace>
                </OptionValues>
            </logLevel>
        </syslog>
    </items>
</model>
